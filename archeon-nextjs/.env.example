# Public site address for portfolio metadata (optional).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Archeon accounts/invoices (REQUIRED for saving, registration, login).
# Guest invoice creation and PDF downloads work without these.
ARCHEON_DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"
# Use 32+ random characters; this is a server secret, not a user password.
ARCHEON_AUTH_RATE_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# No email API key, sender domain or magic-link configuration is needed.
# Optional portfolio contact form requires separately configuring an email service.

# OPTIONAL Gmail OAuth sending, powered by the user's connected Gmail account.
# Use the site root (not /app/invoice). Add identical callback URLs in Google Cloud.
ARCHEON_PUBLIC_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARCHEON_GMAIL_ENCRYPTION_KEY=""
