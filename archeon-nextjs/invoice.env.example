# Invoice Studio and future Archeon accounts.
# Copy to .env.local, replace the placeholders, and NEVER commit this file.
ARCHEON_DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"
# Required for database-backed login/signup throttling (NOT an account password).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARCHEON_AUTH_RATE_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# The Vercel project gets its own HTTPS *.vercel.app address.
# The app no longer needs this variable for password login.

# OPTIONAL Gmail OAuth sending, powered by the user's connected Gmail account.
# Use the site root (not /app/invoice). Add identical callback URLs in Google Cloud.
ARCHEON_PUBLIC_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARCHEON_GMAIL_ENCRYPTION_KEY=""
