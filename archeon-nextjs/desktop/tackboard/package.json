{
  "name": "tackboard-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "The always-on-top TackBoard sticky-note desktop companion by Archeon",
  "main": "src/main.cjs",
  "author": "Archeon",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis portable --x64",
    "pack:win": "electron-builder --win dir --x64",
    "predev": "node scripts/build-core.cjs",
    "pretest": "node scripts/build-core.cjs",
    "predist:win": "node scripts/build-core.cjs",
    "prepack:win": "node scripts/build-core.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.archeon.tackboard",
    "productName": "TackBoard",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
